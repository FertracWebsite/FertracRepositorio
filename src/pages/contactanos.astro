---
import LayoutSecundario from "../layouts/LayoutSecundario.astro";
import FormularioEstructura from "../components/Formularios/FormularioEstructura.astro";


const title = "Contáctanos - Fertrac";
const description = "¿Tienes preguntas o necesitas más información sobre nuestros repuestos para vehiculos de carga? En Fertrac, estamos aquí para ayudarte. Completa nuestro formulario de contacto o envíanos un mensaje por WhatsApp y un miembro de nuestro equipo se pondrá en contacto contigo a la brevedad.";
---

<LayoutSecundario title={title} description={description}>

<div
  class="xl:mt-48 sm:mx-4 sm:w-auto lg:w-[1000px] lg:mx-auto sm:pt-8 sm:m-4 lg:pt-0"
>
  <h1 class="lg:!text-center !sm:text-justify mb-4 text-[36px]">
    Estamos aqui para ti, contactanos en cualquier momento
  </h1>
  <p class="lg:!text-center !sm:text-justify">
    Si tienes alguna duda sobre nuestros servicios, no dudes en preguntarnos.
  </p>
</div>

<section class="flex flex-col  max-lg:max-w-3xl mx-auto items-center ">
    
  <div class="mb-4 border-b border-gray-200 w-full">
    <ul
      class="flex md:flex-wrap sm:flex-wrap text-sm font-medium text-center justify-center"
      id="myTab"
      data-tabs-toggle="#myTabContent"
      role="tablist"
    >
<!--       <p class="flex items-center text-sm text-gray-500 dark:text-gray-400">
        <button
          data-popover-target="popover-description"
          data-popover-placement="bottom-end"
          type="button"
          ><i class="fa-solid fa-circle-question"></i><span class="sr-only"
            >Show information</span
          ></button
        >
      </p> -->
      <div
        data-popover
        id="popover-description"
        role="tooltip"
        class="absolute z-10 invisible inline-block text-sm text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-sm opacity-0 w-72 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400"
      >
        <div class="p-3 space-y-2">
          <h3 class="text-gray-900 !text-base !font-lato font-black">
            Selecciona el formulario que necesites y envíanos tu solicitud.
          </h3>
          <p class="!text-base !font-lato">
            Ponemos a tu disposición canales directos con nuestro equipo para brindarte una atención ágil y especializada, ya sea para gestionar garantías o coordinar acciones con el área de mercadeo.
          </p>
        </div>
        <div data-popper-arrow></div>
      </div>

      <li class="me-2" role="presentation">
        <button
          class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300"
          id="mercadeo-tab"
          data-tabs-target="#mercadeo"
          type="button"
          role="tab"
          aria-controls="mercadeo"
          aria-selected="true">Area de Mercadeo</button
        >
      </li>

      <li class="me-2" role="presentation">
        <button
          class="inline-block p-4 border-b-2 rounded-t-lg hover:text-gray-600 hover:border-gray-300 dark:hover:text-gray-300"
          id="garantias-tab"
          data-tabs-target="#garantias"
          type="button"
          role="tab"
          aria-controls="garantias"
          aria-selected="false">Gestion de Garantias</button
        >
      </li>

    </ul>
  </div>

  <div id="myTabContent">


<div id="mercadeo" role="tabpanel" aria-labelledby="mercadeo-tab" class="hidden">
  <FormularioEstructura
    id="mercadeoForm"
    dataColeccion="formulario_mercadeo"
   tituloForm="Conectemos y hagamos crecer tu negocio"
  descripcionForm="Nuestro equipo de mercadeo se pondrá en contacto contigo para ofrecerte propuestas personalizadas que se adapten a tus necesidades y objetivos."
  imgForm="/img/area-mercadeo.jpg"
    mostrarIdentificacion={true}
    mostrarEmpresa={true}
    mostrarTipoPQRS={false}
    mostrarArchivo={true}
  />
</div>

 <div id="garantias" role="tabpanel" aria-labelledby="pqrs-tab" class="hidden" >

<FormularioEstructura
  id = "garantiasForm"
  dataColeccion="formulario_garantias"
  tituloForm="Formulario de Garantías"
tituloForm="Respaldo y confianza en cada compra"
  descripcionForm="Queremos asegurarnos de que recibas productos de calidad y un servicio confiable. "
  imgForm="/img/gestion-garantias.jpg"
  mostrarIdentificacion={true}
  mostrarEmpresa={true}
  mostrarTipoPQRS={false}
  mostrarArchivo={true}

/>
 </div>



  </div>


</section>

          


</LayoutSecundario>

