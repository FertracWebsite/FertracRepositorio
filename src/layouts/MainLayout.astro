---
import MegaMenu from "../components/MegaMenu.astro";
import Footer from "../components/Footer.astro";
import UltimosPost from "../components/Blog/UltimosPost.astro";
import BotonesFlotantes from "../components/BotonesFlotantes.astro";
import "../estilos.css";

const { title } = Astro.props;
const { descripcion } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="descripcion" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="/img/favicon.png" type="image/x-icon" />

    <link
      rel="preload"
      href="/fuentes/gt-walsheim/GT-Walsheim-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/fuentes/gt-walsheim/GT-Walsheim-Black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />

    <script src="https://static.elfsight.com/platform/platform.js" async
    ></script>


<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-QJDY7CTF4V"></script>
<script is:inline>
  // @ts-ignore
  window.dataLayer = window.dataLayer || [];
  // @ts-ignore
  function gtag(){ dataLayer.push(arguments); }

  gtag('js', new Date());
  gtag('config', 'G-QJDY7CTF4V');
</script>

 <script is:inline set:html={`
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};x
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '894662083184398');
    fbq('track', 'PageView');
  `}></script>

  <noscript>
    <img height="1" width="1" style="display:none"
      src="https://www.facebook.com/tr?id=894662083184398&ev=PageView&noscript=1"
    />
  </noscript>

  </head>

  <body class="overflow-x-hidden">
    <header class="">
      <MegaMenu positionNav="fixed top-0 left-0 w-full z-50" bgNav="white" />
    </header>

    <main class="sm:mt-[90px] md:mt-[120px] lg:mt-0">
      <slot />
      <BotonesFlotantes />
      <UltimosPost />
    </main>

    <footer>
      <Footer />
    </footer>
  </body>
  <script
    src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"
  ></script>

  <script
    type="text/javascript"
    src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"
  ></script>

  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
  ></script>
  <script src="/src/main.js"></script>
</html>
