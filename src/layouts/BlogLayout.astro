---
import AsesoriaEspecialidades from "../components/AsesoriaEspecialidades.astro";
import MegaMenu from "../components/MegaMenu.astro";
import Footer from "../components/Footer.astro";
import BotonesFlotantes from "../components/BotonesFlotantes.astro";
import "../estilos.css";

const { title } = Astro.props;
const { descripcion } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="descripcion" content={descripcion} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="/img/favicon.png" type="image/x-icon" />
    <link rel="stylesheet" href="/src/estilos.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
    <link
      rel="preload"
      href="/fuentes/gt-walsheim/GT-Walsheim-Black.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fuentes/gt-walsheim/GT-Walsheim-Light.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Google Tag Manager -->
<script is:inline>
(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-WCS7HB46');
</script>
<!-- End Google Tag Manager -->

<body>
   <!-- Google Tag Manager (noscript) -->
<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WCS7HB46"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

    <header>      
      <MegaMenu positionNav="fixed top-0 left-0 w-full z-50" />
    </header>

    <main class="sm:mt-[90px] md:mt-[120px] lg:mt-0">
      <slot />
      <BotonesFlotantes />
      <AsesoriaEspecialidades />
    </main>

    <footer>
      <Footer />
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
    ></script>
    <script src="/src/main.js"></script>
    
  </body>
</html>
