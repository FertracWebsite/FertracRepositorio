---
import BotonPrincipal from "./BotonPrincipal.astro"

---

<div
                class="w-full flex justify-center items-center sm:p-4 sm:py-8 lg:py-24 flex-wrap bg-cover  bg-slate-800 gap-4 lg:mt-24 sm:mt-8 bg-[url(/img/trabaja-con-nosotros.jpg)]" style="background-position-x: 73%; background-position-y: center;">
                <div class="2xl:w-[29%] lg:w-[45%] xl:w-[50%] sm:w-full gap-4">
                    <h2 class="!text-white mb-4 md:!text-center lg:!text-left md:px-24  lg:px-8">
                        ¿Te gustaría trabajar con nosotros o convertirte en nuestro proveedor?
                    </h2>
                    <p class="!text-white md:text-center lg:text-left md:px-24  lg:px-8">Siempre estamos en busca de nuevas oportunidades y colaboraciones. Si deseas formar parte de nuestro equipo o ser uno de nuestros proveedores, nos encantaría conocerte.
                        
                    </p>
                   
                </div>  
                <div class="flex flex-col lg:gap-8 sm:gap-4 lg:w-auto sm:w-full md:px-14">
                    <BotonPrincipal url="https://co.indeed.com/cmp/Fertrac-SAS" text="Ofertas Laborales" estilos="bg-naranja hover:bg-transparent hover:text-white hover:border text-white mr-2 " icon="fa-solid fa-paper-plane"/>
                <BotonPrincipal url="https://api.whatsapp.com/send?phone=573112262583" text="Quiero Ser Proveedor" estilos="bg-naranja hover:bg-transparent hover:text-white hover:border text-white mr-2 " icon="fa-solid fa-handshake"/>
                </div>
                
               
            </div>