---
interface Props {
  image: string;
  name: string;
  aplication: string;
}

const { image, name, aplication } = Astro.props as Props;
---

<div
  class="swiper-slide group w-[50px] overflow-hidden rounded-[28px] bg-[#f2790c] p-[8px] shadow-[0_10px_30px_rgba(0,0,0,0.18)]"
>
  <div
    class="relative flex h-[275px] items-center justify-center rounded-[22px] bg-[#f2f2f2]"
  >
    <img src={image} alt={name} class="h-auto w-[250px] object-cover" />
  </div>

  <div class="py-3">
    <p class="my-1 text-base text-white/80 text-center">
      {name}
    </p>

    <h3 class="text-base font-semibold leading-none text-white text-center">
      {aplication}
    </h3>
  </div>
</div>
