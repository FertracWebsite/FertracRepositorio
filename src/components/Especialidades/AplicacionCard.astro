---
const { aplicacion, imageSrc } = Astro.props;
---
<div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md border border-slate-100 transition-all duration-300 group flex flex-col hover:-translate-y-1">
  <div class="relative h-48 overflow-hidden bg-slate-100">
    <!-- Simulated Image or Video Cover -->
    {imageSrc ? (
      <img src={imageSrc} alt={`Aplicación ${aplicacion.brand}`} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out" />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-[#04297e]/5 to-[#04297e]/10 flex items-center justify-center">
        <i class="fa-solid fa-truck text-5xl text-[#04297e]/20"></i>
      </div>
    )}
    
    <!-- Etiqueta superior estilo "New" en el dashboard -->
    <div class="absolute top-4 left-4 bg-[#f2790c] text-white text-[10px] uppercase tracking-wider font-bold px-2.5 py-1 rounded-lg shadow-sm">
      Aplicación
    </div>
    
    <!-- Overlay simulando barra de video y duración (como "Recommended Courses") -->
    <div class="absolute bottom-3 left-4 right-4 flex items-center gap-2">
      <button class="w-8 h-8 rounded-full bg-white/90 text-[#04297e] flex items-center justify-center shadow-md hover:scale-110 transition-transform">
        <i class="fa-solid fa-play text-xs ml-0.5"></i>
      </button>
      <div class="flex-1 h-1.5 bg-white/30 rounded-full overflow-hidden backdrop-blur-sm">
        <div class="h-full bg-white w-1/3"></div>
      </div>
      <span class="text-xs text-white font-medium drop-shadow-md">Detalles</span>
    </div>
  </div>
  
  <div class="p-5 flex flex-col flex-1">
    <h4 class="font-bold text-slate-800 text-lg mb-1 line-clamp-1 group-hover:text-[#04297e] transition-colors">{aplicacion.brand}</h4>
    <p class="text-sm text-slate-500 mb-4 line-clamp-2 leading-relaxed flex-1">{aplicacion.models}</p>
    
    <div class="mt-auto flex items-center justify-between pt-4 border-t border-slate-100">
      <div class="flex items-center gap-1 text-[#f2790c] text-[10px]">
        <i class="fa-solid fa-star"></i>
        <span class="text-slate-700 font-bold ml-1 text-sm">4.9</span>
        <span class="text-slate-400 font-medium ml-0.5">(+100)</span>
      </div>
      <span class="font-bold text-slate-800 text-sm">Ver Catálogo</span>
    </div>
  </div>
</div>
