---
const { aplicacion, imageSrc } = Astro.props;
---

<div
  class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md border border-slate-100 transition-all duration-300 group flex flex-col hover:-translate-y-1"
>
  <div class="p-5 flex flex-col flex-1">
    <h4
      class="font-bold text-slate-800 text-lg mb-1 line-clamp-1 group-hover:text-[#04297e] transition-colors"
    >
      {aplicacion.brand}
    </h4>
    <p class="text-sm text-slate-500 line-clamp-5 leading-relaxed flex-1">
      {aplicacion.models}
    </p>
  </div>
</div>
