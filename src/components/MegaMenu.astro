.barras_menu {
  width: 30px;
  height: 30px;   
  cursor: pointer;
  color:white;
}

.barras_menu span {
  display: block;
  width: 100%;
  height: 2px;
  background: white;
  margin-top: 6px;
  transform-origin: 0px 100%;
  transition: all 600ms;


}

.activar1 {
  transform: rotate(45deg)
  translate(-2px, 1px);

}
.activar2 {
  opacity: 0;
  margin-left: -30px;
}

.activar3 {
  transform: rotate(-45deg)
  translate(-4px, 2px);
}


.scrolled {
  : #f2790c;
}

.hover-underline-animation {
  display: inline-block;
  position: relative;
}
.hover-underline-animation::after {
  content: '';
  position: absolute;
  width: 100%;
  transform: scaleX(0);
  height: 2px;
  bottom: 0;
  left: 0;
  background-color: #f2790c;
  transform-origin: bottom right;
  transition: transform 0.25s ease-out;
}
.hover-underline-animation:hover::after {
  transform: scaleX(1);
  transform-origin: bottom left;
}

.sm_menu a {
  font-size: 16px;
}
</style>

 <script>



    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const dropdownToggles = document.querySelectorAll('.dropdown-toggle');

    //
    mobileMenuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
    // 

    // 
    dropdownToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const dropdown = toggle.nextElementSibling;
        const otherDropdowns = document.querySelectorAll('.dropdown');

        otherDropdowns.forEach((d) => {
          if (d !== dropdown) {
            d.classList.add('hidden');

          }
        });

        dropdown.classList.toggle('hidden');
        toggle.querySelector('.rotate').classList.toggle('rotate-180');
      });
    });



document.querySelector(".barras_menu").addEventListener("click", animacion);

var linea1__barras = document.querySelector(".linea1__barras");
var linea2__barras = document.querySelector(".linea2__barras");
var linea3__barras = document.querySelector(".linea3__barras");

function animacion () {
    linea1__barras.classList.toggle("activar1")
    linea2__barras.classList.toggle("activar2")
    linea3__barras.classList.toggle("activar3")

}
