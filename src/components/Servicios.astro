---
import BotonPrincipal from "./BotonPrincipal.astro";
---

<section class="lg:my-32 sm:my-8 flex gap-4 flex-col sm:px-4 ">
    
  <div class="flex flex-col items-center justify-center xl:gap-4 sm:gap-2 ">
    <h2>Nuestros Servicios</h2>
    <p class="sm:px:4 md:px-24 xl:w-2/4 sm:w-full md:!text-center">
      Estamos comprometidos a ofrecer soluciones completas para el mantenimiento
      y reparación de vehículos de carga.
    </p>
  </div>


<div
  class="swiper-content carrusel1  2xl:max-w-[1500px] xl:max-w-[1300px] w-full sm:py-0 sm:mb-10 lg:my-10 mx-auto"
>
  <div class="swiper-wrapper">

      <div class="swiper-slide  rounded-lg border-2 shadow-lg ">
      <div class=" bg-white border border-gray-200 rounded-lg shadow">
        <img class="rounded-t-lg" src="/img/solicitud-credito.webp" alt="" />
        <div class="p-5">
          <h3 class="mb-2 tracking-tight">Solicita tu crédito.</h3>
          <p class="mb-3"> En Fertrac queremos facilitar el acceso a los repuestos que tu operación necesita, ofreciéndote un proceso ágil, seguro y adaptado a tus necesidades.
          </p>

          <BotonPrincipal
            url="/servicios/"
            text="Solicitar Credito"
            estilos="hover:bg-white text-white bg-naranja hover:border border-naranja hover:text-naranja lg:w-full"
            icon="fa-solid fa-envelope-open-text"
          />
        </div>
      </div>
    </div>

        <div class="swiper-slide  rounded-lg border-2 shadow-lg">
      <div class=" bg-white border border-gray-200 rounded-lg shadow">
        <img class="rounded-t-lg" src="/img/brochure-fertrac.webp" alt="" />
        <div class="p-5">
          <h3 class="mb-2 tracking-tight">
            Brochure Corporativo
          </h3>
          <p class="mb-3">
            Consulta nuestro brochure digital con todas nuestras especialidades
            y soluciones en repuestos para tractocamiones.
          </p>
          <BotonPrincipal
            url="https://drive.google.com/file/d/1zVLDKDr5oqocJ05Y04TinTUU-C7lL7q2/view?usp=sharing"
            text="Descargar Catalogo PDF"
            estilos="hover:bg-white text-white bg-naranja hover:border border-naranja hover:text-naranja lg:w-full"
            icon="fa-solid fa-file-arrow-down"
          />
        </div>
      </div>
    </div>

    <div class="swiper-slide  rounded-lg border-2 shadow-lg ">
      <div class=" bg-white border border-gray-200 rounded-lg shadow">
        <img
          class="rounded-t-lg"
          src="/img/asesoria-tecnica.png"
          alt="asddsa"
        />
        <div class="p-5">
          <h3 class="mb-2 tracking-tight">Aseroria Tecnica</h3>
          <p class="mb-3">
            Brindamos asistencia técnica experta, soluciones ágiles y
            acompañamiento constante para ofrecer repuestos originales.
          </p>
          <BotonPrincipal
            url="https://api.whatsapp.com/send?phone=573124615606&text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre..."
            text="Mas Información"
            estilos="hover:bg-white text-white bg-naranja hover:border border-naranja hover:text-naranja lg:w-full"
            icon="fa-solid fa-arrow-right"
          />
        </div>
      </div>
    </div>



      <div class="swiper-slide  rounded-lg border-2 shadow-lg ">
      <div class=" bg-white border border-gray-200 rounded-lg shadow">
        <img class="rounded-t-lg" src="/img/productos-fertrac.png" alt="" />
        <div class="p-5">
          <h3 class="mb-2 tracking-tight sm:text-xl lg:text-2xl">
            Repuestos para tractocamiones.
          </h3>
          <p class="mb-3">
            Repuestos para vehículos de carga con calidad, confianza y marcas
            líderes. Soluciones eficientes para mantener tu flota en movimiento.
          </p>
          <BotonPrincipal
            url="https://api.whatsapp.com/send?phone=573124615606&text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre..."
            text="Solicitar Información"
            estilos="hover:bg-white text-white bg-naranja hover:border border-naranja hover:text-naranja lg:w-full"
            icon="fa-solid fa-arrow-right"
          />
        </div>
      </div>
    </div>



    <div class="swiper-slide  rounded-lg border-2 shadow-lg">
      <div class=" bg-white border border-gray-200 rounded-lg shadow">
        <img
          class="rounded-t-lg"
          src="/img/innovación-investigación.webp"
          alt=""
        />
        <div class="p-5">
          <h3 class="mb-2  tracking-tight">
            Innovación e Investigación
          </h3>
          <p class="mb-3">
            Dedicados a investigar y comprender nuevos equipos de carga,
            asegurando estar a la vanguardia de productos y demandas.
          </p>
          <BotonPrincipal
            text="Más Información"
            estilos="hover:bg-white text-white bg-naranja hover:border border-naranja hover:text-naranja lg:w-full"
            icon="fa-solid fa-arrow-right"
            url="/blog/"
          />
        </div>
      </div>
    </div>
  </div>
  <div class="swiper-button-next carrusel1-next"></div>
  <div class="swiper-button-prev carrusel1-prev"></div>
</div>
</section>


<style>
  .swiper-content {
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .swiper-button-next {
    right: 0;
    color: #f2790c;
  }
  .swiper-button-prev {
    left: 0;
    color: #f2790c;
  }

  .swiper-slide {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .swiper-slide img {
    object-fit: contain;
  }

  .swiper-button-next,
  .swiper-button-prev {
    display: block;
  }
  .swiper-button-next {
    right: 20px;
  }
  .swiper-button-prev {
    left: 20px;
  }


</style>

<script>
  import Swiper from "swiper/bundle";
  import "swiper/swiper-bundle.css";

  document.addEventListener("DOMContentLoaded", function () {
    var swiper = new Swiper(".carrusel1", {
      slidesPerView: 3,
      slidesPerGroup: 1,
      spaceBetween: 25,
      loop: true,
      speed: 1000,
      grabCursor: true,
      pagination: {
        el: ".carrusel-pagination",
        clickable: true,
        dynamicBullets: true,
      },
      navigation: {
        nextEl: ".carrusel1-next",
        prevEl: ".carrusel1-prev",
      },
      breakpoints: {
        0: {
          slidesPerView: 1,
          slidesPerGroup: 1,
        },
        520: {
          slidesPerView: 2,
          slidesPerGroup: 2,
        },

        768: {
          slidesPerView: 2,
          slidesPerGroup: 1,
        },

        950: {
          slidesPerView: 3,
          slidesPerGroup: 1,
        },
      },
    });
  });
</script>
