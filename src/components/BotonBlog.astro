---
export interface Props {
  tiempoLectura: string;
}

const { tiempoLectura } = Astro.props;
---

<div
  class="flex flex-col  text-naranja py-2"
>
  <span class="lg:text-base sm:text-base text-left">Tiempo de lectura aproximado: {tiempoLectura}</span>

  <button class="relative effect text-azul py-2 hover:text-azul font-black text-left w-fit text-lg tracking-wide">Seguir Leyendo</button>
</div>

<style>
  .effect:after {
    background: none repeat scroll 0 0 transparent;
    bottom: 0;
    content: "";
    height: 2px;
    left: 50%;
    position: absolute;
    background: #04297e;
    transition:
      width 0.3s ease 0s,
      left 0.3s ease 0s;
  }
  .effect:hover:after {
    width: 100%;
    left: 0;
  }
</style>
