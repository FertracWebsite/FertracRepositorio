---
import BotonPrincipal from "../BotonPrincipal.astro";

const {
  id,
  dataColeccion,
  titulo,
  mostrarAreaDirigida,
  mostrarIdentificacion,
  mostrarEmpresa,
  mostrarTipoPQRS,
  mostrarArchivo,
  role,
  ariaLabelledby,
  tituloForm,
  descripcionForm,
  imgForm,
} = Astro.props;
---

<div
  class="lg:p-16 rounded-lg bg-gray-50 dark:bg-gray-800 animacion from-left flex items-center justify-center sm:flex-wrap lg:flex-nowrap gap-4 p-4"
  role="tabpanel"
  aria-labelledby="pqrs-tab"
>
  <div
    class="relative items-end overflow-hidden rounded-lg shadow transition hover:shadow-lg w-full max-w-lg bg-slate-600 sm:h-[500px] lg:h-[850px]"
  >
    <img
      src={imgForm}
      alt=""
      class="right-0inset-0 h-full w-full object-cover object-center"
    />

    <div
      class="relative bg-gradient-to-t from-gray-900/50 to-gray-900/100 p-4 bottom-[155px] left-0"
    >
      <h3 class="!text-white">{tituloForm}</h3>
      <p class="mt-2 text-sm/relaxed !text-white/95 parrafo">
        {descripcionForm}
      </p>
    </div>
    y
  </div>

  <form
    id={id}
    class="w-full max-w-4xl mx-auto p-4 bg-white rounded-lg shadow-md"
    data-coleccion={dataColeccion}
    role={role}
    aria-labelledby={ariaLabelledby}
  >
    <div class="pb-4">
      <div class="w-full max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:gap-4 sm:gap-0">
          <!-- Nombres -->
          <div class="field">
            <label for="nombres">Nombres</label>
            <div class="relative">
              <div
                class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
              >
                <i class="fa-solid fa-user"></i>
              </div>
              <input
                type="text"
                name="nombres"
                id="nombres"
                placeholder="Carlos"
                required
                class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 pe-4 text-gray-800 text-sm ps-10"
              />
            </div>
          </div>

          <!-- Apellidos -->
          <div class="field">
            <label for="apellidos">Apellidos</label>
            <div class="relative">
              <div
                class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
              >
                <i class="fa-solid fa-user"></i>
              </div>
              <input
                type="text"
                name="apellidos"
                id="apellidos"
                placeholder="Ramírez"
                required
                class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 pe-4 text-gray-800 text-sm ps-10"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Email -->
      <div class="field">
        <label for="email">Correo electrónico</label>
        <div class="relative">
          <div
            class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
          >
            <i class="fa-solid fa-envelope"></i>
          </div>
          <input
            type="email"
            name="email"
            id="email"
            placeholder="correo@ejemplo.com"
            required
            class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 px-4 text-gray-800 text-sm ps-10"
          />
        </div>
      </div>

      <!-- Teléfono -->
      <div class="field">
        <label for="telefono">Teléfono</label>
        <div class="relative">
          <div
            class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none"
          >
            <i class="fa-solid fa-phone"></i>
          </div>
          <input
            type="tel"
            name="telefono"
            id="telefono"
            placeholder="123 456 7890"
            required
            class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 px-4 text-gray-800 text-sm ps-10"
          />
        </div>
      </div>

      {
        mostrarIdentificacion && (
          <div class="field">
            <label for="identificacion">Identificación (NIT / CC)</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <i class="fa-solid fa-id-card" />
              </div>
              <input
                type="text"
                name="identificacion"
                id="identificacion"
                placeholder="Numero de Identificación"
                class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 px-4 text-gray-800 text-sm ps-10"
              />
            </div>
          </div>
        )
      }

      {
        mostrarEmpresa && (
          <div class="field">
            <label for="empresa">Empresa</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <i class="fa-solid fa-building" />
              </div>
              <input
                type="text"
                name="empresa"
                id="empresa"
                placeholder="Mi empresa S.A.S"
                class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 px-4 text-gray-800 text-sm ps-10"
              />
            </div>
          </div>
        )
      }

      
      {
        mostrarAreaDirigida && (
          <div class="field">
            <label for="area_dirigida">Area Dirigida</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <i class="fa-solid fa-list" />
              </div>
              <select
                name="area"
                id="area"
                required
                class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 px-4 text-gray-800 text-sm ps-10"
              >
                <option value="" disabled selected>Selecciona el area a la cual te comunicas</option>
                <option value="Gestión_Humana">Gestión Humana</option>
                <option value="Gestión_Garantias">Gestión de Garantias</option>
                <option value="Mercadeo">Mercadeo</option>
                <option value="Ventas">Ventas</option>
              </select>
            </div>
          </div>
        )
      }

      {
        mostrarTipoPQRS && (
          <div class="field">
            <label for="tipo_queja">Tipo de solicitud</label>
            <div class="relative">
              <div class="absolute inset-y-0 start-0 flex items-center ps-3.5 pointer-events-none">
                <i class="fa-solid fa-list" />
              </div>
              <select
                name="tipo_queja"
                id="tipo_queja"
                required
                class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 px-4 text-gray-800 text-sm ps-10"
              >
                <option value="" disabled selected>Selecciona el tipo de solicitud</option>
                <option value="Petición">Petición</option>
                <option value="Queja">Queja</option>
                <option value="Reclamo">Reclamo</option>
                <option value="Sugerencia">Sugerencia</option>
              </select>
            </div>
          </div>
        )
      }

      <!-- Mensaje -->
      <div class="field">
        <label for="mensaje">Mensaje</label>
        <div class="relative">
          <div
            class="absolute inset-y-0 start-0 flex items-start ps-3.5 pt-3 pointer-events-none"
          >
            <i class="fa-solid fa-comment-dots"></i>
          </div>
          <textarea
            name="mensaje"
            id="mensaje"
            rows="5"
            required
            class="w-full border-gray-300 bg-gray-100 rounded-lg py-3 px-4 text-gray-800 text-sm ps-10"
            placeholder="Escribe tu mensaje aquí..."></textarea>
        </div>
      </div>

      <div class="field">
        <label for="documento">Archivo adjunto</label>
        <input
          name="documento"
          type="file"
          id="fileInput"
          class="hidden w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-naranja file:text-white hover:file:bg-orange-600"
        />
      </div>

      <!-- Botón -->
      <BotonPrincipal
        type="submit"
        icon="fa-solid fa-arrow-right"
        text="Enviar Formulario"
        estilos="w-full bg-naranja hover:bg-white hover:text-naranja hover:border border-naranja text-white mr-2 !px-0"
      />

      <!--   <button type="submit" class="w-full bg-naranja text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition mt-4">
    Enviar formulario
  </button> -->

      <p
        id="respuesta"
        class="hidden text-green-600 text-center font-medium mt-2"
      >
        ¡Formulario enviado exitosamente!
      </p>

      <!-- Política -->
      <div class="mt-4 text-sm">
        <label class="flex items-center space-x-2">
          <input
            type="checkbox"
            name="dataConsent"
            id="dataConsent"
            value="si"
            required
            class="w-4 h-4 text-blue-600 border-gray-300 rounded"
          />
          <span class="text-gray-700 dark:text-gray-300">
            Acepto la
            <a
              href="/img/politica-manejo-de-datos.pdf"
              class="text-azul hover:underline"
              download="politica-manejo-de-datos.pdf"
            >
              Política de Datos
            </a>
          </span>
        </label>
      </div>
    </div>
  </form>
</div>

  <style>
    .input {
      @apply border border-gray-300 rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-naranja/50 my-2;
    }
    .field {
      margin-bottom: 10px;
    }

    .field label {
      display: block;
      font-size: 16px;
      color: #777;
    }

    .field input {
      display: block;

      line-height: 1.5;
      font-size: 14px;
    }

    .animacion {
      transition:
        opacity 0s ease,
        filter 0.5s ease;
      animation: fadeInUp 1s ease forwards;
      animation-delay: 1s;
    }

    .from-left {
      opacity: 0;
      filter: blur(4px);
      animation: fadeInLeft 1s ease forwards;
      animation-delay: 0.1s;
    }

    .no-scroll {
      overflow: hidden;
      height: 100vh;
    }

    @keyframes fadeInLeft {
      0% {
        opacity: 0;
        transform: translateX(-50px);
      }
      100% {
        opacity: 1;
        transform: translateX(0);
        filter: blur(0);
      }
    }
  </style>



<script type="module">
  import {
    configurarEnvioFormulario,
    configurarValidacionTelefono,
  } from "../../scripts/scriptFormulario.js";

  configurarEnvioFormulario("pqrsForm", "template_5903hhf");
  configurarEnvioFormulario("mercadeoForm", "template_5903hhf");
  configurarEnvioFormulario("garantiasForm", "template_5903hhf");
  configurarEnvioFormulario("rrhhForm", "template_5903hhf");
  configurarValidacionTelefono();
</script>


