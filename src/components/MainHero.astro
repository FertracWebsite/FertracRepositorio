<style>

@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateX(-1000px);
    filter: blur(4px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
    filter: blur(0);
  }
}

.animate-fade-in-up {
  animation: fadeInUp 1s ease-out forwards;
}
</style>
