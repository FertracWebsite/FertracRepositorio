---
import BotonPrincipal from "./BotonPrincipal.astro";
---

<section class="hero-section bg-cover bg-center" style="background-image: url(/img/hero.jpg);">
  <div class="container mx-auto h-full flex items-center justify-start px-4 lg:px-20 py-20">
    <div class="text-white max-w-2xl animate-fade-in-up">
      <span class="bg-naranja px-4 py-2 inline-block text-xl text-white text-lato tracking-wides rounded-r-xl mb-4">
        Fertrac tiene presencia en todo el territorio Colombiano
      </span>
      <h1 class="text-white text-left 2xl:text-6xl xl:text-5xl lg:text-7xl sm:text-3xl md:text-[60px] font-bold leading-none mb-4">
        Venta de respuestos originales para vehículos de carga
      </h1>
      <p class="text-white text-left leading-[25px] mb-6">
        Nos especializamos en ofrecer una amplia gama de repuestos originales de alta calidad para vehículos de carga, diseñados para garantizar el máximo rendimiento y la durabilidad.
      </p>
      <BotonPrincipal 
        url="https://api.whatsapp.com/send?phone=573124615606&text=Hola%2C%20necesito%20informaci%C3%B3n%20sobre..." 
        icon="fa-brands fa-whatsapp" 
        text="Solicita una Cotización" 
        estilos="bg-naranja hover:bg-white hover:text-naranja hover:border text-white mr-2 sm:!w-full lg:!w-auto"
      />
    </div>
  </div>
</section>

<style>
.hero-section {
  height: 80vh;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center;
  background: linear-gradient(150deg, #f2790c, #db6600, #000000), url(/img/hero.jpg);
}

@keyframes fadeInUp {
  0% {
    opacity: 0;
    transform: translateX(-1000px);
    filter: blur(4px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
    filter: blur(0);
  }
}

.animate-fade-in-up {
  animation: fadeInUp 1s ease-out forwards;
}
</style>
