---
// src/components/Blog/CategoryFilter.astro
interface Props {
  categories: string[];
  activeCategory?: string;
  title?: string;
}

const {
  categories = [
    "All Articles",
    "Fintech",
    "Finance Tips",
    "Security",
    "Budgeting",
    "Technology",
  ],
  activeCategory = "All Articles",
  title = "All Articles",
} = Astro.props;
---

<div class="flex flex-col items-center justify-center w-full my-12 px-4">
  <h2
    class="text-4xl md:text-[44px] font-bold text-[#1A1A24] mb-8 font-GTWalsheim tracking-tight"
  >
    {title}
  </h2>

  <div
    class="flex flex-wrap items-center justify-center gap-3 md:gap-4 max-w-4xl mx-auto"
  >
    {
      categories.map((category) => {
        const isActive = category === activeCategory;
        return (
          <button
            type="button"
            data-category={category}
            class={`category-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-naranja
            ${
              isActive
                ? "bg-naranja text-white shadow-md active-category"
                : "bg-[#F3F4F8] text-[#5A5D70] hover:bg-naranja hover:text-white hover:shadow-md inactive-category"
            }`}
            aria-pressed={isActive ? "true" : "false"}
          >
            {category}
          </button>
        );
      })
    }
  </div>
</div>

<script>
  const setupFilters = () => {
    const buttons = document.querySelectorAll(".category-btn");
    const posts = document.querySelectorAll(".blog-post-item");

    if (!buttons.length || !posts.length) return;

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const category = button.getAttribute("data-category");

        // Update button styles
        buttons.forEach((btn) => {
          btn.setAttribute("aria-pressed", "false");
          btn.classList.remove(
            "bg-naranja",
            "text-white",
            "shadow-md",
            "active-category",
          );
          btn.classList.add(
            "bg-[#F3F4F8]",
            "text-[#5A5D70]",
            "hover:bg-naranja",
            "hover:text-white",
            "hover:shadow-md",
            "inactive-category",
          );
        });

        button.setAttribute("aria-pressed", "true");
        button.classList.remove(
          "bg-[#F3F4F8]",
          "text-[#5A5D70]",
          "hover:bg-naranja",
          "hover:text-white",
          "hover:shadow-md",
          "inactive-category",
        );
        button.classList.add(
          "bg-naranja",
          "text-white",
          "shadow-md",
          "active-category",
        );

        // Filter posts
        posts.forEach((post) => {
          const tagsAttr = post.getAttribute("data-tags");
          // Limpiar espacios en los tags para evitar problemas de matching
          const tags = tagsAttr ? tagsAttr.split(",").map((t) => t.trim()) : [];

          if (category === "Todos" || tags.includes(category)) {
            post.style.display = "";
            setTimeout(() => {
              post.style.opacity = "1";
            }, 10);
          } else {
            post.style.display = "none";
            post.style.opacity = "0";
          }
        });
      });
    });
  };

  setupFilters();
  document.addEventListener("astro:page-load", setupFilters);
</script>
